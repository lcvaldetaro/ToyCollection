#!/bin/bash
# Find the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

is_intel_jdk() {
    local home_path="$1"
    if [ -f "$home_path/bin/java" ]; then
        if file "$home_path/bin/java" | grep -q "x86_64"; then
            return 0
        fi
    fi
    return 1
}

is_valid_jdk() {
    [ -n "$1" ] && [ -d "$1" ] && [ -f "$1/bin/jpackage" ] && is_intel_jdk "$1"
}

FOUND_JAVA_HOME=""

# Search for a suitable Intel JDK with jpackage (Java 21 or 17)
for version in 21 17; do
    if [ -x /usr/libexec/java_home ]; then
        DETECTED_JAVA_HOME=$(/usr/libexec/java_home -a x86_64 --failfast -v "$version" 2>/dev/null)
        if is_valid_jdk "$DETECTED_JAVA_HOME"; then
            FOUND_JAVA_HOME="$DETECTED_JAVA_HOME"
            break
        fi
    fi

    # Check Gradle provisioned JDKs, SDKMAN, and standard Homebrew directories
    for search_dir in "/Library/Java/JavaVirtualMachines" "$HOME/Library/Java/JavaVirtualMachines" "$HOME/.gradle/jdks" "$HOME/.sdkman/candidates/java" "/usr/local/opt"; do
        if [ -d "$search_dir" ]; then
            MATCHING_DIRS=$(find "$search_dir" -type d \( -path "*-$version-*/*/Contents/Home" -o -path "*-$version-*/*/Home" -o -path "*$version*/*/Contents/Home" -o -path "*$version*/*/Home" -o -path "*openjdk@$version*/*/Contents/Home" \) 2>/dev/null)
            for d in $MATCHING_DIRS; do
                if is_valid_jdk "$d"; then
                    FOUND_JAVA_HOME="$d"
                    break 2
                fi
            done
        fi
    done
done

# Fallback to any Intel JDK with jpackage if no Java 21/17 was specifically matched
if [ -z "$FOUND_JAVA_HOME" ]; then
    if [ -x /usr/libexec/java_home ]; then
        DETECTED_JAVA_HOME=$(/usr/libexec/java_home -a x86_64 2>/dev/null)
        if is_valid_jdk "$DETECTED_JAVA_HOME"; then
            FOUND_JAVA_HOME="$DETECTED_JAVA_HOME"
        fi
    fi
fi

if [ -z "$FOUND_JAVA_HOME" ]; then
    for search_dir in "/Library/Java/JavaVirtualMachines" "$HOME/Library/Java/JavaVirtualMachines" "$HOME/.gradle/jdks" "$HOME/.sdkman/candidates/java" "/usr/local/opt"; do
        if [ -d "$search_dir" ]; then
            MATCHING_DIRS=$(find "$search_dir" -type d \( -path "*/Contents/Home" -o "*/Home" \) 2>/dev/null)
            for d in $MATCHING_DIRS; do
                if is_valid_jdk "$d"; then
                    FOUND_JAVA_HOME="$d"
                    break 2
                fi
            done
        fi
    done
fi

if [ -n "$FOUND_JAVA_HOME" ]; then
    export JAVA_HOME="$FOUND_JAVA_HOME"
    export PATH="$JAVA_HOME/bin:$PATH"
    echo "Using Intel JDK at: $JAVA_HOME"
else
    echo "Warning: No Intel JDK with 'jpackage' tool found. DMG/PKG generation might fail."
    echo "Please download and install an Intel (x86_64) JDK 17 or 21."
fi

# Run Gradle with target architecture set to Intel under Rosetta emulation
exec arch -x86_64 "$SCRIPT_DIR/gradlew" -PmacArch=intel "$@"
