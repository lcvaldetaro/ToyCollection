#!/bin/bash
# Find the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

HOST_ARCH=$(uname -m)
IS_APPLE_SILICON=false
if [ "$HOST_ARCH" = "arm64" ] || [ "$(sysctl -in sysctl.proc_translated 2>/dev/null)" = "1" ]; then
    IS_APPLE_SILICON=true
fi

if $IS_APPLE_SILICON; then
    ARCH_FLAG="arm64"
else
    ARCH_FLAG="x86_64"
fi

is_arm64_jdk() {
    local home_path="$1"
    if [ -f "$home_path/bin/java" ]; then
        if file "$home_path/bin/java" | grep -q -E "arm64|aarch64"; then
            return 0
        fi
    fi
    return 1
}

is_intel_jdk() {
    local home_path="$1"
    if [ -f "$home_path/bin/java" ]; then
        if file "$home_path/bin/java" | grep -q "x86_64"; then
            return 0
        fi
    fi
    return 1
}

is_valid_jdk() {
    if [ -z "$1" ] || [ ! -d "$1" ] || [ ! -f "$1/bin/jpackage" ]; then
        return 1
    fi
    if $IS_APPLE_SILICON; then
        is_arm64_jdk "$1"
    else
        is_intel_jdk "$1"
    fi
}

FOUND_JAVA_HOME=""

# 1. First, check if there is a local project-specific .jdk matching target architecture
if is_valid_jdk "$SCRIPT_DIR/.jdk/Contents/Home"; then
    FOUND_JAVA_HOME="$SCRIPT_DIR/.jdk/Contents/Home"
fi

# 2. Search for a suitable JDK with jpackage (Java 21 or 17)
if [ -z "$FOUND_JAVA_HOME" ]; then
    for version in 21 17; do
        if [ -x /usr/libexec/java_home ]; then
            DETECTED_JAVA_HOME=$(/usr/libexec/java_home -a "$ARCH_FLAG" --failfast -v "$version" 2>/dev/null)
            if is_valid_jdk "$DETECTED_JAVA_HOME"; then
                FOUND_JAVA_HOME="$DETECTED_JAVA_HOME"
                break
            fi
        fi

        # Check Gradle provisioned JDKs, SDKMAN, and standard Homebrew directories
        for search_dir in "/Library/Java/JavaVirtualMachines" "$HOME/Library/Java/JavaVirtualMachines" "$HOME/.gradle/jdks" "$HOME/.sdkman/candidates/java" "/opt/homebrew/opt" "/usr/local/opt"; do
            if [ -d "$search_dir" ]; then
                MATCHING_DIRS=$(find "$search_dir" -type d \( -path "*-$version-*/*/Contents/Home" -o -path "*-$version-*/*/Home" -o -path "*$version*/*/Contents/Home" -o -path "*$version*/*/Home" -o -path "*openjdk@$version*/*/Contents/Home" \) 2>/dev/null)
                for d in $MATCHING_DIRS; do
                    if is_valid_jdk "$d"; then
                        FOUND_JAVA_HOME="$d"
                        break 2
                    fi
                done
            fi
        done
    done
fi

# Fallback: search for ANY JDK matching the architecture with jpackage
if [ -z "$FOUND_JAVA_HOME" ]; then
    if [ -x /usr/libexec/java_home ]; then
        DETECTED_JAVA_HOME=$(/usr/libexec/java_home -a "$ARCH_FLAG" 2>/dev/null)
        if is_valid_jdk "$DETECTED_JAVA_HOME"; then
            FOUND_JAVA_HOME="$DETECTED_JAVA_HOME"
        fi
    fi
fi

if [ -z "$FOUND_JAVA_HOME" ]; then
    for search_dir in "/Library/Java/JavaVirtualMachines" "$HOME/Library/Java/JavaVirtualMachines" "$HOME/.gradle/jdks" "$HOME/.sdkman/candidates/java" "/opt/homebrew/opt" "/usr/local/opt"; do
        if [ -d "$search_dir" ]; then
            MATCHING_DIRS=$(find "$search_dir" -type d \( -path "*/Contents/Home" -o "*/Home" \) 2>/dev/null)
            for d in $MATCHING_DIRS; do
                if is_valid_jdk "$d"; then
                    FOUND_JAVA_HOME="$d"
                    break 2
                fi
            done
        fi
    done
fi

if [ -n "$FOUND_JAVA_HOME" ]; then
    export JAVA_HOME="$FOUND_JAVA_HOME"
    export PATH="$JAVA_HOME/bin:$PATH"
    echo "Using JDK with jpackage at: $JAVA_HOME"
else
    echo "Warning: No valid $ARCH_FLAG JDK with 'jpackage' tool found. DMG/PKG generation might fail."
    if $IS_APPLE_SILICON; then
        echo "Please download and install an Apple Silicon (aarch64/arm64) JDK 17 or 21."
    else
        echo "Please download and install an Intel (x86_64) JDK 17 or 21."
    fi
fi

if $IS_APPLE_SILICON; then
    exec "$SCRIPT_DIR/gradlew" -PmacArch=arm64 "$@"
else
    exec "$SCRIPT_DIR/gradlew" -PmacArch=intel "$@"
fi
