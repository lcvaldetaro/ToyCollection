#!/bin/bash
# Find the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 1. First, check if there is a local project-specific .jdk
if [ -d "$SCRIPT_DIR/.jdk/Contents/Home" ]; then
    export JAVA_HOME="$SCRIPT_DIR/.jdk/Contents/Home"
# 2. Second, check if a global JDK with jpackage is installed via macOS java_home utility
elif [ -x /usr/libexec/java_home ]; then
    DETECTED_JAVA_HOME=$(/usr/libexec/java_home -v 21 2>/dev/null || /usr/libexec/java_home -v 17 2>/dev/null || /usr/libexec/java_home 2>/dev/null)
    if [ -n "$DETECTED_JAVA_HOME" ] && [ -f "$DETECTED_JAVA_HOME/bin/jpackage" ]; then
        export JAVA_HOME="$DETECTED_JAVA_HOME"
    fi
fi

# 3. Third, if JAVA_HOME is still empty or doesn't have jpackage, look in ~/.gradle/jdks/
if [ -z "$JAVA_HOME" ] || [ ! -f "$JAVA_HOME/bin/jpackage" ]; then
    GRADLE_JDK_DIR=$(find "$HOME/.gradle/jdks" -type d -path "*/Contents/Home" -print -quit 2>/dev/null || find "$HOME/.gradle/jdks" -type d -name "Home" -print -quit 2>/dev/null)
    if [ -n "$GRADLE_JDK_DIR" ] && [ -f "$GRADLE_JDK_DIR/bin/jpackage" ]; then
        export JAVA_HOME="$GRADLE_JDK_DIR"
    fi
fi

if [ -n "$JAVA_HOME" ]; then
    export PATH="$JAVA_HOME/bin:$PATH"
    echo "Using JDK with jpackage at: $JAVA_HOME"
else
    echo "Warning: No JDK with 'jpackage' tool found. DMG/PKG generation might fail."
fi

exec "$SCRIPT_DIR/gradlew" "$@"
